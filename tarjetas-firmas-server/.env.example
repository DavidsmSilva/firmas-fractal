# ─── Configuración de Azure AD (solo para producción) ─────────────────────
# Obtené estos valores desde Azure Portal → App Registrations → tu app
# En DEV_MODE=true no se usan, pueden estar vacíos

AZURE_TENANT_ID=              # GUID del tenant: 00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=              # GUID de la app registration
AZURE_CLIENT_SECRET=          # Secret de Certificates & Secrets

# ─── URLs de redireccionamiento (producción) ──────────────────────────────
# En desarrollo (DEV_MODE=true) no se usan. En producción apuntan al dominio real.
AZURE_REDIRECT_URI=https://firma.estrategiasfractal.com/auth/redirect
AZURE_LOGOUT_URI=https://login.microsoftonline.com/common/oauth2/v2.0/logout
AZURE_POST_LOGOUT_URI=https://firma.estrategiasfractal.com

# ─── Servidor ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development           # development | production
SESSION_SECRET=                # Opcional: si se deja vacío, se genera automático

# ─── Modo de autenticación ─────────────────────────────────────────────────
DEV_MODE=true                  # true  → login simulado (sin Azure, ideal para localhost)
                                # false → login con Microsoft Entra ID (producción)
