# ─── Configuración de Azure AD (solo para Easy Auth en SWA) ──────────────
# Estos valores se configuran en Azure Portal:
# Static Web App → Settings → Environment variables → Application settings
# O en su defecto, en el App Registration asociado a Easy Auth.
#
# Ya NO se usa el server Node.js con MSAL.
# Easy Auth maneja la autenticación en el edge.

AZURE_TENANT_ID=751504e2-fdcc-4a03-8654-f8b4519e2270
AZURE_CLIENT_ID=              # Client ID del App Registration en Azure AD
AZURE_CLIENT_SECRET=          # Secret del App Registration

# ─── URLs (producción) ──────────────────────────────────────────────────
# La SWA hostea en icy-sky-038c5ea0f.7.azurestaticapps.net
# Después se configura dominio personalizado: firma.estrategiasfractal.com
AZURE_REDIRECT_URI=https://icy-sky-038c5ea0f.7.azurestaticapps.net
AZURE_POST_LOGOUT_URI=https://icy-sky-038c5ea0f.7.azurestaticapps.net

# ─── Servidor (solo para desarrollo local con Node.js) ──────────────────
PORT=3000
NODE_ENV=development
SESSION_SECRET=

# ─── Modo desarrollo ────────────────────────────────────────────────────
DEV_MODE=true                  # true  → login simulado (local, sin Azure)
                               # false → login con Easy Auth (producción SWA)
